# --------------------
# DATABASE
# --------------------
# For SQLite, the file path is the URL
DATABASE_URL="sqlite:///./user_management.db"

# --------------------
# JWT AUTHENTICATION SETTINGS
# --------------------
# ⚠️ Generate a secure secret key and replace this placeholder.
# You can generate one using: secrets.token_urlsafe(32) in Python.
SECRET_KEY="KQ8^B`S'=Oem%#I5"

# Algorithm used for signing the token (HS256 is standard)
ALGORITHM="HS256"

# Token expiration time in minutes (e.g., 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60